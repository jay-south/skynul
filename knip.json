{
  "$schema": "https://unpkg.com/knip/schema.json",
  "entry": [
    "electron.vite.config.ts",
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/renderer/src/main.tsx"
  ],
  "project": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/src/**/*.{ts,tsx}",
    "src/shared/**/*.ts"
  ],
  "ignoreDependencies": ["@types/better-sqlite3"],
  "ignoreExportsUsedInFile": true
}
